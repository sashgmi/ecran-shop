# Réglages privés de l'écran shop - ne partagez pas ce fichier.
# Après modification, demandez à Claude de redémarrer le site (ou relancez `npm start`).

# Mot de passe de la page de gestion (à changer avant la mise en ligne)
ADMIN_PASSWORD=

# Boîte qui reçoit les messages « Nous écrire »
MAIL_TO=sabeck@tesla.com

# Compte Gmail d'envoi (le « facteur »)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# 1) Votre adresse Gmail dédiée, ex. ecran.shop.charleroi@gmail.com
SMTP_USER=
# 2) Le mot de passe d'application de 16 lettres (sans espaces)
SMTP_PASS=
